<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UltimaMilla.Repartidor.SplashPage"
             BackgroundColor="#1565C0">

    <VerticalStackLayout
        HorizontalOptions="Center"
        VerticalOptions="Center"
        Spacing="16">

        <Image Source="marca.png"
               WidthRequest="200"
               HeightRequest="200"
               Aspect="AspectFit" />

        <Label Text="Última Milla"
               TextColor="White"
               FontSize="30"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <Label Text="Cargando..."
               TextColor="White"
               FontSize="16"
               HorizontalOptions="Center" />

    </VerticalStackLayout>

</ContentPage>