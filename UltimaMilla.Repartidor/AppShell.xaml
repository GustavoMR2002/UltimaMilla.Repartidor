<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:UltimaMilla.Repartidor"
       x:Class="UltimaMilla.Repartidor.AppShell"
       FlyoutBehavior="Disabled">
    <ShellContent Route="LoginPage"
                  ContentTemplate="{DataTemplate local:LoginPage}" />
    <TabBar>
        <ShellContent Title="Jornada" Route="JornadaPage" Icon="jornada.png"
                      ContentTemplate="{DataTemplate local:JornadaPage}" />
        <ShellContent Title="Histórico" Route="HistoricoPage" Icon="historico.png"
                      ContentTemplate="{DataTemplate local:HistoricoPage}" />
    </TabBar>
</Shell>
