<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:UltimaMilla.Repartidor.Models"
             x:Class="UltimaMilla.Repartidor.JornadaPage"
             Title="Mi jornada">

    <ContentPage.Resources>
        <Style TargetType="Border">
            <Setter Property="Stroke" Value="#1565C0" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape"
                    Value="RoundRectangle 12" />
            <Setter Property="BackgroundColor"
                    Value="{AppThemeBinding Light=#F5F8FC, Dark=#202B38}" />
        </Style>
    </ContentPage.Resources>

    <Grid x:Name="PaginaGrid"
          Padding="20"
          RowDefinitions="Auto,Auto,*,Auto"
          RowSpacing="12">

        <!-- Encabezado -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="10">

            <VerticalStackLayout Spacing="4">
                <Label x:Name="SaludoLabel"
                       Style="{StaticResource TituloJornada}" />

                <Label x:Name="FechaLabel"
                       Style="{StaticResource TextoSecundario}" />
            </VerticalStackLayout>

            <Button x:Name="ActualizarBtn"
                    Grid.Column="1"
                    Text="Actualizar"
                    VerticalOptions="Center"
                    Clicked="OnActualizarClicked" />
        </Grid>

        <!-- Tarjetas de resumen -->
        <Grid x:Name="ResumenGrid"
              Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="12">

            <Border Padding="12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Entregas de hoy"
                           Style="{StaticResource TextoSecundario}" />

                    <Label x:Name="TotalLabel"
                           Style="{StaticResource NumeroResumen}" />
                </VerticalStackLayout>
            </Border>

            <Border Grid.Column="1" Padding="12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Entregas completadas"
                           Style="{StaticResource TextoSecundario}" />

                    <Label x:Name="CompletadasLabel"
                           Style="{StaticResource NumeroResumen}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Lista con su propio desplazamiento -->
        <CollectionView x:Name="ParadasView"
                Grid.Row="2"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                ItemsLayout="VerticalList"
                ItemSizingStrategy="MeasureAllItems"
                SelectionMode="None">

            <CollectionView.EmptyView>
                <Label Text="No tienes paradas hoy"
                       Style="{StaticResource TextoSecundario}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Parada">
                    <Border Padding="12" Margin="0,4">

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Property="Opacity"
                                                Value="1" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Property="Opacity"
                                                Value="0.55" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="OnParadaTapped"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="12">

                            <Border BackgroundColor="#1565C0"
                                    StrokeThickness="0"
                                    WidthRequest="34"
                                    HeightRequest="34"
                                    VerticalOptions="Center"
                                    StrokeShape="RoundRectangle 17">

                                <Label Text="{Binding Numero}"
                                       TextColor="White"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="3">

                                <Label Text="{Binding Cliente}"
                                       Style="{StaticResource ClienteLabel}" />

                                <Label Text="{Binding Direccion}"
                                       Style="{StaticResource TextoSecundario}" />

                                <Label Text="{Binding Estado}">
                                    <Label.Style>
                                        <Style TargetType="Label">
                                            <Setter Property="FontSize"
                                                    Value="12" />
                                            <Setter Property="TextColor"
                                                    Value="Gray" />

                                            <Style.Triggers>
                                                <DataTrigger
                                                    TargetType="Label"
                                                    Binding="{Binding Estado}"
                                                    Value="Pendiente">
                                                    <Setter
                                                        Property="TextColor"
                                                        Value="{AppThemeBinding Light=#946200, Dark=#FFD166}" />
                                                </DataTrigger>

                                                <DataTrigger
                                                    TargetType="Label"
                                                    Binding="{Binding Estado}"
                                                    Value="Entregada">
                                                    <Setter
                                                        Property="TextColor"
                                                        Value="{AppThemeBinding Light=#237A36, Dark=#81C784}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Label.Style>
                                </Label>

                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Controles de prueba -->
        <Grid x:Name="PruebasPanel"
              Grid.Row="3"
              ColumnDefinitions="*,*"
              ColumnSpacing="10">

            <Button Text="Agregar prueba"
                    Clicked="OnAgregarPruebaClicked" />

            <Button Grid.Column="1"
                    Text="Vaciar lista"
                    Clicked="OnVaciarClicked" />
        </Grid>

    </Grid>
</ContentPage>