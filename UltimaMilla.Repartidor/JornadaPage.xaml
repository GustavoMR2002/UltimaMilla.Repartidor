<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:UltimaMilla.Repartidor.Models"
             xmlns:vm="clr-namespace:UltimaMilla.Repartidor.ViewModels"
             x:Class="UltimaMilla.Repartidor.JornadaPage"
             x:DataType="vm:JornadaViewModel"
             Title="Mi jornada">

    <ContentPage.Resources>
        <Style TargetType="Border">
            <Setter Property="Stroke" Value="#1565C0" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="BackgroundColor"
                    Value="{AppThemeBinding Light=#F5F8FC, Dark=#202B38}" />
        </Style>
    </ContentPage.Resources>

    <Grid x:Name="PaginaGrid"
          Padding="20"
          RowDefinitions="Auto,Auto,Auto,*,Auto"
          RowSpacing="12">

        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="10">

            <VerticalStackLayout Spacing="4">
                <Label x:Name="SaludoLabel"
                       Text="{Binding Saludo}"
                       Style="{StaticResource TituloJornada}" />

                <Label Text="{Binding Fecha}"
                       Style="{StaticResource TextoSecundario}" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="1"
                                 Spacing="4"
                                 VerticalOptions="Center">

                <Button Text="Actualizar"
                        Command="{Binding RefrescarCommand}" />

                <ActivityIndicator
                    IsRunning="{Binding EstaCargando}"
                    IsVisible="{Binding EstaCargando}"
                    HeightRequest="20"
                    Color="{AppThemeBinding Light=#1565C0, Dark=#90CAF9}" />
            </VerticalStackLayout>
        </Grid>

        <Grid x:Name="ResumenGrid"
              Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="12">

            <Border Padding="12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Entregas de hoy"
                           Style="{StaticResource TextoSecundario}" />

                    <Label x:Name="TotalLabel"
                           Text="{Binding TotalEntregas}"
                           Style="{StaticResource NumeroResumen}" />
                </VerticalStackLayout>
            </Border>

            <Border Grid.Column="1" Padding="12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Entregas completadas"
                           Style="{StaticResource TextoSecundario}" />

                    <Label x:Name="CompletadasLabel"
                           Text="{Binding EntregasCompletadas}"
                           Style="{StaticResource NumeroResumen}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <Label Text="Ocultar entregadas"
                   VerticalOptions="Center"
                   Style="{StaticResource TextoSecundario}" />

            <Switch Grid.Column="1"
                    IsToggled="{Binding OcultarEntregadas, Mode=TwoWay}" />
        </Grid>

        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding Paradas}"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill"
                        ItemsLayout="VerticalList"
                        ItemSizingStrategy="MeasureAllItems"
                        SelectionMode="None">

            <CollectionView.EmptyView>
                <Label Text="{Binding MensajeListaVacia}"
                       Style="{StaticResource TextoSecundario}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Parada">
                    <Border Padding="12" Margin="0,4">

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Property="Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Property="Opacity" Value="0.55" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="OnParadaTapped"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border BackgroundColor="#1565C0"
                                    StrokeThickness="0"
                                    WidthRequest="34"
                                    HeightRequest="34"
                                    VerticalOptions="Center"
                                    StrokeShape="RoundRectangle 17">

                                <Label Text="{Binding Numero}"
                                       TextColor="White"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="{Binding Cliente}"
                                       Style="{StaticResource ClienteLabel}" />

                                <Label Text="{Binding Direccion}"
                                       Style="{StaticResource TextoSecundario}" />

                                <Label Text="{Binding Estado}">
                                    <Label.Style>
                                        <Style TargetType="Label">
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="TextColor" Value="Gray" />

                                            <Style.Triggers>
                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding Estado}"
                                                             Value="Pendiente">
                                                    <Setter Property="TextColor"
                                                            Value="{AppThemeBinding Light=#946200, Dark=#FFD166}" />
                                                </DataTrigger>

                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding Estado}"
                                                             Value="Entregada">
                                                    <Setter Property="TextColor"
                                                            Value="{AppThemeBinding Light=#237A36, Dark=#81C784}" />
                                                </DataTrigger>

                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding Estado}"
                                                             Value="Fallida">
                                                    <Setter Property="TextColor"
                                                            Value="{AppThemeBinding Light=#B3261E, Dark=#FFB4AB}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Label.Style>
                                </Label>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="4"
               Text="{Binding MensajeEstado}"
               Style="{StaticResource TextoSecundario}">
            <Label.Triggers>
                <DataTrigger TargetType="Label"
                             Binding="{Binding MensajeEstado}"
                             Value="">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
            </Label.Triggers>
        </Label>

    </Grid>
</ContentPage>